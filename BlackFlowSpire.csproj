<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BlackFlowSpire</AssemblyName>
    <RootNamespace>BlackFlowSpire</RootNamespace>
    <Version>0.7.12</Version>
    <Configurations>Debug;Release;ExportDebug;ExportRelease</Configurations>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Limit the root project to owned source/assets, excluding dllsrc, tools, tests and build caches. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <BlackFlowSpirePackageDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'artifacts/mods/BlackFlowSpire'))</BlackFlowSpirePackageDirectory>
  </PropertyGroup>
  <Import Project="BlackFlowSpire.References.props" />
  <ItemGroup>
    <Compile Include="BlackFlowSpireCode/**/*.cs" />
    <EmbeddedResource Include="BlackFlowSpire/Data/collectibles.json" LogicalName="BlackFlowSpire.Data.collectibles.json" />
    <EmbeddedResource Include="BlackFlowSpire/localization/eng/*.json" LogicalName="BlackFlowSpire.Localization.%(Filename).eng.json" />
    <EmbeddedResource Include="BlackFlowSpire/localization/zhs/*.json" LogicalName="BlackFlowSpire.Localization.%(Filename).zhs.json" />
    <None Include="BlackFlowSpire/**/*;project.godot;export_presets.cfg;mod_manifest.json;README.md" />
  </ItemGroup>
  <Target Name="StageBlackFlowSpireMod" AfterTargets="Build">
    <MakeDir Directories="$(BlackFlowSpirePackageDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/mod_manifest.json"
          DestinationFolder="$(BlackFlowSpirePackageDirectory)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/artifacts/symbols" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildProjectDirectory)/artifacts/symbols"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
